# ---------------------------------------------------------------------------
# BestBudget configuration. Copy to .env and fill in the values marked REQUIRED.
# ---------------------------------------------------------------------------

# REQUIRED. Public URL users open in the browser (behind a reverse proxy — the https:// URL).
# Used for cookies, CSRF origin checks, invitation links and the SSO callback.
APP_URL=http://localhost:3000

# REQUIRED. Random secret for sessions, at least 32 characters: `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# Optional. Key for encrypting secrets stored in the database (OIDC client secret).
# Defaults to a key derived from BETTER_AUTH_SECRET. Changing it makes stored secrets unreadable.
ENCRYPTION_KEY=

# REQUIRED for first start. One-time token for creating the first administrator at /setup.
# Generate with `openssl rand -hex 16`; you may remove it after setup.
SETUP_TOKEN=

# Image version used by compose.yaml (ghcr.io/mambastick/bestbudget:<version>).
BESTBUDGET_VERSION=1.0.0-beta.1

# --- PostgreSQL (used by compose.yaml) -------------------------------------
POSTGRES_DB=bestbudget
POSTGRES_USER=bestbudget
# REQUIRED. `openssl rand -hex 16`
POSTGRES_PASSWORD=
# Set only when running the app outside Docker Compose:
# DATABASE_URL=postgres://bestbudget:password@localhost:5432/bestbudget
# DB_POOL_MAX=10

# --- Backups --------------------------------------------------------------
# Every night at BACKUP_TIME in TZ; filenames always use UTC.
TZ=Europe/Moscow
BACKUP_TIME=03:00
BACKUP_PATH=./backups
# Keep the newest 7 successful copies PLUS all copies from the last 30 days.
BACKUP_KEEP_LAST=7
BACKUP_KEEP_DAYS=30
# Containers run without root. Set these to `id -u` / `id -g` for your non-root Linux account if its UID differs.
LOCAL_UID=1000
LOCAL_GID=1000
# Optional S3: set bucket and credentials. For Yandex/MinIO also set endpoint/region.
BACKUP_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_PREFIX=bestbudget

# --- Network ---------------------------------------------------------------
# Host port and bind address. Behind a reverse proxy on the same host use APP_BIND=127.0.0.1.
APP_PORT=3000
APP_BIND=0.0.0.0
# Trust X-Forwarded-For from the reverse proxy for rate limiting and session IPs.
TRUST_PROXY=false

# --- Emergency access --------------------------------------------------------
# Forces e-mail/password login on even if an admin disabled it (e.g. after an SSO outage).
AUTH_FORCE_LOCAL_LOGIN=false

# --- SSO (OpenID Connect). Environment variables take priority over the admin UI. ---
# Leave OIDC_ISSUER empty to configure SSO in Администрирование → Авторизация instead.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
OIDC_DISPLAY_NAME=SSO
# Default: ${APP_URL}/api/auth/callback/oidc — register this URI at the provider.
OIDC_REDIRECT_URI=
OIDC_ENABLED=true
# Create accounts on first SSO login. When false, new users need an invitation.
OIDC_ALLOW_SIGNUP=false

# --- E-mail (optional): enables self-service password reset ---------------
# SMTP_URL=smtps://user:password@smtp.example.com:465
# SMTP_FROM=BestBudget <budget@example.com>
