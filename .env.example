# ---------------------------------------------------------------------------
# BestBudget configuration. Copy to .env and fill in the values marked REQUIRED.
# ---------------------------------------------------------------------------

# REQUIRED. Public URL users open in the browser (behind a reverse proxy — the https:// URL).
# Used for cookies, CSRF origin checks, invitation links and the SSO callback.
APP_URL=http://localhost:3000

# REQUIRED. Random secret for sessions, at least 32 characters: `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# Optional. Key for encrypting secrets stored in the database (OIDC client secret).
# Defaults to a key derived from BETTER_AUTH_SECRET. Changing it makes stored secrets unreadable.
ENCRYPTION_KEY=

# REQUIRED for first start. One-time token for creating the first administrator at /setup.
# Generate with `openssl rand -hex 16`; you may remove it after setup.
SETUP_TOKEN=

# Image version used by compose.yaml (ghcr.io/mambastick/bestbudget:<version>).
BESTBUDGET_VERSION=1.0.0-beta.4

# --- PostgreSQL (used by compose.yaml) -------------------------------------
POSTGRES_DB=bestbudget
POSTGRES_USER=bestbudget
# REQUIRED. `openssl rand -hex 16`
POSTGRES_PASSWORD=
# Set only when running the app outside Docker Compose:
# DATABASE_URL=postgres://bestbudget:password@localhost:5432/bestbudget
# DB_POOL_MAX=10

# --- Backups --------------------------------------------------------------
# Optional convenience for installations without their own PostgreSQL backups.
# false disables automatic dumps; manual backup now/list/restore still work.
BACKUP_ENABLED=true
# Every night at BACKUP_TIME in TZ; filenames always use UTC.
TZ=Europe/Moscow
BACKUP_TIME=03:00
BACKUP_PATH=./backups
# Keep the newest 7 successful copies PLUS all copies from the last 30 days.
BACKUP_KEEP_LAST=7
BACKUP_KEEP_DAYS=30
# Containers run without root. Set these to `id -u` / `id -g` for your non-root Linux account if its UID differs.
LOCAL_UID=1000
LOCAL_GID=1000
# Optional S3: set bucket and credentials. For Yandex/MinIO also set endpoint/region.
BACKUP_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_PREFIX=bestbudget

# --- Network ---------------------------------------------------------------
# Host port and bind address. Behind a reverse proxy on the same host use APP_BIND=127.0.0.1.
APP_PORT=3000
APP_BIND=0.0.0.0
# Trust X-Forwarded-For from the reverse proxy for rate limiting and session IPs.
TRUST_PROXY=false

# --- Emergency access --------------------------------------------------------
# Forces e-mail/password login on even if an admin disabled it (e.g. after an SSO outage).
AUTH_FORCE_LOCAL_LOGIN=false

# --- SSO (OpenID Connect). Environment variables take priority over the admin UI. ---
# Leave OIDC_ISSUER empty to configure SSO in Администрирование → Авторизация instead.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
OIDC_DISPLAY_NAME=SSO
# Default: ${APP_URL}/api/auth/callback/oidc — register this URI at the provider.
OIDC_REDIRECT_URI=
OIDC_ENABLED=true
# Create accounts on first SSO login. When false, new users need an invitation.
OIDC_ALLOW_SIGNUP=false
# Optional system role synchronization. Set all three together; leave all empty to keep manual roles.
# The provider must return a top-level array of exact group names in the verified OIDC profile.
# Admin membership alone is sufficient; other identities cannot sign in when mapping is enabled.
OIDC_GROUPS_CLAIM=
OIDC_USER_GROUP=
OIDC_ADMIN_GROUP=

# --- E-mail (optional): enables self-service password reset ---------------
# SMTP_URL=smtps://user:password@smtp.example.com:465
# SMTP_FROM=BestBudget <budget@example.com>

# --- Exchange rates -------------------------------------------------------
# cbr: lazy Bank of Russia XML rates + DB cache; none: manual rates only, no FX network requests.
FX_PROVIDER=cbr

# --- Payment reminders (all channels opt-in in each user's profile) ----------
JOBS_ENABLED=true
# Leave empty to configure the bot in Администрирование → Уведомления.
TELEGRAM_BOT_TOKEN=
# Optional override; default is polling (also configurable in the admin UI).
# TELEGRAM_MODE=polling
# For webhook mode; otherwise a random secret is generated and encrypted in the DB.
TELEGRAM_WEBHOOK_SECRET=
# Optional pair; otherwise generated once and persisted in the DB (private key encrypted).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Public HTTPS URL or mailto: contact. Default: HTTPS APP_URL, or mailto:admin@localhost for HTTP.
VAPID_SUBJECT=

# --- AI assistant (disabled by default; see docs/ai.md) -----------------------
# Leave AI_PROVIDER unset to configure in the admin UI. ENV takes priority.
# AI_PROVIDER=openai_compatible
# AI_BASE_URL=http://ollama:11434/v1
# AI_API_KEY=
# AI_MODEL=your-tool-capable-model
# AI_ENABLED=false
# AI_TEMPERATURE=
# AI_MONTHLY_TOKEN_LIMIT=0
# AI_SELF_HOSTED=true
# AI_GIGACHAT_SCOPE=GIGACHAT_API_PERS
# AI_GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
# Add a trusted CA PEM via a mounted file; never disable TLS verification.
# NODE_EXTRA_CA_CERTS=/app/certs/russian-trusted-ca.pem
