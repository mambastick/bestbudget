{
  "name": "bestbudget",
  "private": true,
  "version": "1.0.0-beta.8",
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/check-ai-build.mjs && pnpm build:scripts",
    "build:scripts": "esbuild scripts/migrate.ts scripts/admin.ts scripts/backup.ts --bundle --platform=node --format=esm --target=node22 --outdir=dist-scripts --out-extension:.js=.mjs --packages=bundle --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:dev": "tsx scripts/dev-db.ts",
    "admin": "tsx scripts/admin.ts",
    "db:seed-demo": "node --conditions=react-server --import tsx scripts/seed-demo.ts",
    "test:screenshots": "playwright test --config playwright.screenshots.config.ts",
    "i18n:check": "tsx scripts/check-i18n.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.96",
    "@ai-sdk/google": "4.0.111",
    "@ai-sdk/openai": "4.0.108",
    "@ai-sdk/openai-compatible": "3.0.84",
    "@ai-sdk/react": "4.0.166",
    "@animate-ui/react": "^2.4.2",
    "@aws-sdk/client-s3": "^3.1161.0",
    "@base-ui/react": "^1.4.1",
    "@fontsource-variable/inter": "^5.2.8",
    "ai": "7.0.162",
    "better-auth": "^1.7.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "lucide-react": "^1.67.0",
    "motion": "^14.9.0",
    "next": "^16.4.5",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.3.1",
    "postgres": "^3.4.9",
    "re2js": "^2.9.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-markdown": "10.1.0",
    "read-excel-file": "^9.3.14",
    "recharts": "^3.10.1",
    "remark-gfm": "4.0.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "use-intl": "4.14.9",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@electric-sql/pglite-socket": "^0.2.18",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^24.12.3",
    "@types/nodemailer": "^7.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "oauth2-mock-server": "^9.3.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
